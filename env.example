# Copy Vault — Environment Variables
# Copy this file to .env for local development.
# In Replit, set these as Secrets instead of editing this file.

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Database ──────────────────────────────────────────────────────────────────
# Provided automatically by Replit (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Solana ────────────────────────────────────────────────────────────────────
# Use your provider key, or set SOLANA_RPC_URL for a full custom endpoint.
SOLANA_RPC_API_KEY=your_helius_api_key
SOLANA_RPC_URL=

# ── Ethereum ──────────────────────────────────────────────────────────────────
# Use your provider key, or set ETHEREUM_RPC_URL for a full custom endpoint.
ETHEREUM_RPC_API_KEY=your_alchemy_api_key
ETHEREUM_RPC_URL=

# ── BNB Chain ─────────────────────────────────────────────────────────────────
# Any BNB-compatible RPC endpoint
BNB_RPC_URL=https://your-bnb-rpc-endpoint
# Legacy alias still supported:
BNB_RPC_API_KEY=

# ── Prices ────────────────────────────────────────────────────────────────────
# CoinGecko Demo/Pro API key: https://coingecko.com/api
PRICE_API_KEY=your_coingecko_api_key

# ── Jupiter Swap API (Solana DEX routing) ─────────────────────────────────────
# Get an API key from https://portal.jup.ag/. The bot sends it as x-api-key.
JUPITER_API_KEY=your_jupiter_api_key

# ── Security ──────────────────────────────────────────────────────────────────
# Used to encrypt private keys at rest – must be kept secret and stable!
ENCRYPTION_KEY=a-long-random-string-at-least-32-chars

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
